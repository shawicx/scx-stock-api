# 应用
SCX_APP_ENV=dev
SCX_APP_HOST=0.0.0.0
SCX_APP_PORT=8000
SCX_LOG_LEVEL=INFO

# 数据库（PostgreSQL）
# 开发环境端口 5433；生产环境独立 PG 容器端口 5434
SCX_DB_HOST=127.0.0.1
SCX_DB_PORT=5433
SCX_DB_USER=postgres
SCX_DB_PASSWORD=postgres
SCX_DB_NAME=scx-stock
SCX_DB_ECHO=false
# 服务启动时若目标库不存在是否自动创建（开发期便利；生产建议关闭）
SCX_DB_AUTO_CREATE=true

# 缓存（Redis）
# 开发环境端口 6379；生产环境独立 Redis 容器端口 6389
SCX_REDIS_HOST=127.0.0.1
SCX_REDIS_PORT=6379
SCX_REDIS_DB=0
# SCX_REDIS_PASSWORD=

# 数据源
SCX_DEFAULT_PROVIDER=akshare
SCX_REQUEST_TIMEOUT=10

# CORS（逗号分隔的源列表；'*' 表示允许全部）
# 开发环境含本地联调端口；生产环境需加入前端域名/IP:6900
SCX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:6900,http://127.0.0.1:6900

# 分页
SCX_DEFAULT_PAGE_SIZE=20
SCX_MAX_PAGE_SIZE=100

# 限流
SCX_AI_RATE_LIMIT_PER_MINUTE=20

# 关注列表（逗号分隔代码，股票/ETF 均可），供每日分析任务使用
SCX_WATCHLIST=510300,159915,512100,159327

# 每日报告收件人（逗号分隔邮箱）
SCX_NOTIFY_EMAILS=*****@qq.com

# LLM 配置（OpenAI 兼容接口，provider: glm | deepseek）
# DeepSeek: base_url=https://api.deepseek.com/v1, model=deepseek-chat
# GLM:      base_url=https://open.bigmodel.cn/api/paas/v4, model=glm-4-flash
SCX_LLM_PROVIDER=deepseek
SCX_LLM_API_KEY=sk-******
SCX_LLM_BASE_URL=https://api.deepseek.com/v1
SCX_LLM_MODEL=deepseek-chat
SCX_LLM_TIMEOUT=30

# SMTP 邮件配置（以 QQ 邮箱为例，password 为授权码）
SCX_SMTP_HOST=smtp.qq.com
SCX_SMTP_PORT=587
SCX_SMTP_USER=****@qq.com
SCX_SMTP_PASSWORD=****
SCX_SMTP_FROM_NAME=ETF日报
SCX_SMTP_USE_SSL=true

# 分析任务（每个交易日 21:00 运行，Asia/Shanghai）
SCX_ANALYSIS_CRON=0 21 * * 1-5
# K 线窗口（交易日数）
SCX_ANALYSIS_KLINE_DAYS=5
